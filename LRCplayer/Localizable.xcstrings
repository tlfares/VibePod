      }
    },
    "Missing covers, albums, genres and years, from Apple Music and Deezer. Only empty fields are filled." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochettes, albums, genres et années manquants, depuis Apple Music et Deezer. Seuls les champs vides sont remplis."
          }
        }
      }
    },
    "Missing Metadata" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Métadonnées manquantes"
          }
        }
      }
    },
    "Mistral AI transcribes the vocals and syncs them to the song. The song's audio is sent to Mistral; you can delete the result anytime." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistral AI transcrit les voix et les synchronise avec le morceau. L’audio du morceau est envoyé à Mistral ; vous pouvez supprimer le résultat à tout moment."
          }
        }
      }
    },
    "Mistral API Key" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé API Mistral"
          }
        }
      }
    },
    "Mistral asked to slow down. Resuming shortly…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistral demande de ralentir. Reprise dans un instant…"
          }
        }
      }
    },
    "Mistral couldn't process the request: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistral n’a pas pu traiter la demande : %@"
          }
        }
      }
    },
    "Mistral didn't accept the API key. Check it in Settings › Tools › AI Features." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistral n’a pas accepté la clé API. Vérifiez-la dans Réglages › Outils › Fonctions IA."
          }
        }
      }
    },
    "Mistral didn't accept this key. Copy it again from console.mistral.ai." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistral n’a pas accepté cette clé. Copiez-la à nouveau depuis console.mistral.ai."
          }
        }
      }
    },
    "Mistral is limiting requests on this key for now. Try again in a minute." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistral limite les requêtes sur cette clé pour l’instant. Réessayez dans une minute."
          }
        }
      }
    },
    "Mistral sums up each song's lyrics in one sentence, so the assistant finds a song by its subject and builds mixes around a theme. Visible and editable in the song's Info." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistral résume les paroles de chaque son en une phrase : l’assistant retrouve un son par son sujet et fait des mix par thème. Visible et modifiable dans la fiche Infos du son."
          }
        }
      }
    },
    "Mistral writes a new one the next time songs are summed up." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistral en écrira un nouveau au prochain résumé des sons."
          }
        }
      }
