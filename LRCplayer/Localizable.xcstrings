    },
    "Tennis" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tennis"
          }
        }
      }
    },
    "The artwork the playlist was imported with." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pochette avec laquelle la playlist a été importée."
          }
        }
      }
    },
    "The assistant uses these in every answer. They stay on this iPhone and only go to the model answering." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant s’en sert dans toutes ses réponses. Ça reste sur cet iPhone, et n’est envoyé qu’au modèle qui répond."
          }
        }
      }
    },
    "The best bits of %lld songs with synced lyrics." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les meilleurs passages de %lld morceaux avec paroles synchronisées."
          }
        }
      }
    },
    "The clip goes on after the song (an ending scene): set how long, and the picture starts with the song." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip continue après le morceau (une scène de fin) : indiquez sa durée, l’image démarre avec le morceau."
          }
        }
      }
    },
    "The clip starts before the song (an opening scene): set how long. Also shifts a picture that runs ahead of or behind the song." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip commence avant le morceau (une scène d’ouverture) : indiquez sa durée. Sert aussi à recaler une image en avance ou en retard sur le morceau."
          }
        }
      }
    },
    "The clip's own sound plays. If its intro puts the lyrics out of step, shift them here." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est le son du clip qui joue. Si son intro décale les paroles, recale-les ici."
          }
        }
      }
    },
    "The covers of the first four albums in the playlist." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pochettes des quatre premiers albums de la playlist."
          }
        }
      }
    },
    "The lines light one after another, over the song. Sync the song word by word for the full effect." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vers s'illuminent l'un après l'autre, sur la musique. Synchronisez le morceau mot à mot pour l'effet complet."
          }
        }
      }
    },
    "The lines light word by word, like in the player, over the song." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vers s'illuminent mot à mot, comme dans le lecteur, sur la musique."
          }
        }
      }
    },
    "The merged song couldn't be made." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le morceau fusionné n'a pas pu être créé."
          }
        }
      }
    },
    "The more it knows about your music, the better it answers." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus il connaît ta musique, mieux il répond."
          }
        }
      }
    },
    "The music video didn't load. Tap the cover to try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip ne s'est pas chargé. Touchez la cover pour réessayer."
          }
        }
      }
    },
    "The newest songs in your library." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les morceaux les plus récents de votre bibliothèque."
          }
        }
      }
    },
    "The outro's lyrics disappear and the next song plays as soon as it starts, as if the song ended there." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles de l'outro disparaissent et le morceau suivant démarre dès qu'elle commence, comme si le morceau s'arrêtait là."
          }
        }
      }
    },
    "The outro's lyrics stay, but the games won't ask about them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles de l'outro restent affichées, mais les jeux ne les demanderont pas."
          }
        }
      }
    },
    "The playlist to play." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La playlist à lire."
          }
        }
