    },
    "Talk to LRCplayer Assistant" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parler à l’assistant LRCplayer"
          }
        }
      }
    },
    "Tap the cover in Now Playing: the song's YouTube music video takes its place, muted and in time with your file. Tap it again for the cover." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la pochette dans À l’écoute : le clip YouTube du morceau prend sa place, muet et calé sur votre fichier. Touchez-le à nouveau pour revenir à la pochette."
          }
        }
      }
    },
    "Tap the first sung word" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le premier mot chanté"
          }
        }
      }
    },
    "Tap the lines around it to add them" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez les vers autour pour les ajouter"
          }
        }
      }
    },
    "Tap the outro's first word" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le premier mot de l'outro"
          }
        }
      }
    },
    "Tap the tiles as they reach the line. Hold the long ones." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez les tuiles quand elles atteignent la ligne. Maintenez les longues."
          }
        }
      }
    },
    "Tap the tiles to the beat." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez les tuiles en rythme."
          }
        }
      }
    },
    "Tap to Show" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquer pour afficher"
          }
        }
      }
    },
    "Tell It About You" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle-lui de toi"
          }
        }
      }
    },
    "Tells how many songs, artists, albums and playlists are in the LRCplayer library." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique combien de morceaux, d’artistes, d’albums et de playlists contient la bibliothèque LRCplayer."
          }
        }
      }
    },
    "Tells which song LRCplayer is playing, with the lyric line being sung when there is one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique quel morceau LRCplayer est en train de lire, avec la ligne de paroles chantée s’il y en a une."
          }
        }
      }
    },
    "Tempo" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo"
          }
        }
