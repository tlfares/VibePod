    },
    "Your Discord profile shows what you're listening to, with the song, the artist and the time left. Covers come from Apple's catalog." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil Discord montre ce que vous écoutez, avec le morceau, l’artiste et le temps restant. Les pochettes viennent du catalogue d’Apple."
          }
        }
      }
    },
    "Your key stays private on this iPhone, in its Keychain: it isn't synced to iCloud nor included in backups, and it's only ever sent to Mistral, when you use an AI feature." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé reste privée sur cet iPhone, dans son trousseau : elle n’est ni synchronisée avec iCloud ni incluse dans les sauvegardes, et n’est envoyée qu’à Mistral, quand vous utilisez une fonction IA."
          }
        }
      }
    },
