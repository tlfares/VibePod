    "NSHealthShareUsageDescription" : {
      "comment" : "Health read permission",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VibePod reads your workouts to find the music you play while you exercise. Nothing leaves your iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VibePod lit vos entraînements pour savoir quelle musique vous écoutez pendant le sport. Rien ne quitte votre iPhone."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Health write permission (required by App Store, not used)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VibePod doesn't write to Health. It only reads your workouts to find the music you play while you exercise."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VibePod n'écrit rien dans Santé. L'app lit seulement vos entraînements pour retrouver la musique écoutée pendant le sport."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send songs to your other devices nearby, and receive them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer des morceaux à vos autres appareils à proximité, et en recevoir."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talk to the assistant: ask for music hands-free."
